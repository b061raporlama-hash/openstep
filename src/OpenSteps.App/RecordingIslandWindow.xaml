<Window x:Class="OpenSteps.App.RecordingIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenSteps recording" Width="340" Height="76"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False">
    <Border Margin="8" CornerRadius="30" Background="#D9C5DCFA" BorderBrush="#90FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25" />
        </Border.Effect>
        <Grid Margin="10,5,16,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <Button x:Name="StopButton" Click="Stop_Click" Cursor="Hand"
                    AutomationProperties.Name="Stop Recording" ToolTip="Stop recording and save HTML">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="22">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="38" Height="38" Margin="0,0,10,0">
                        <Ellipse Fill="#F43F46" />
                        <Rectangle Width="13" Height="13" RadiusX="1" RadiusY="1" Fill="White" />
                    </Grid>
                    <TextBlock x:Name="StopLabel" Text="Stop Recording" FontSize="13" Foreground="#152238" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Rectangle Grid.Column="1" Height="26" Fill="#508294B1" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#152238" Margin="0,0,9,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StepCountText" Text="0 steps" FontSize="13" FontWeight="SemiBold" Foreground="#152238" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
